      },
      {
        "Name": "x4033",
        "Description": "Exports at 4033 x 4033 pixels, commonly used for large terrain tiles.",
        "Type": "EnumValue",
        "IsGroup": false
      },
      {
        "Name": "x2017",
        "Description": "Exports at 2017 x 2017 pixels, ideal for medium-sized terrain tiles.",
        "Type": "EnumValue",
        "IsGroup": false
      },
      {
        "Name": "x1009",
        "Description": "Exports at 1009 x 1009 pixels, suitable for smaller terrain tiles or test scenes.",
        "Type": "EnumValue",
        "IsGroup": false
      },
      {
        "Name": "x505",
        "Description": "Exports at 505 x 505 pixels, used for small terrain tiles or prototyping.",
        "Type": "EnumValue",
        "IsGroup": false
      }
    ]
  },
  {
    "Name": "Dont Resize Textures",
    "Description": "Prevents automatic resizing of textures during export, preserving the original resolution of input textures.",
    "Type": "Boolean",
    "IsGroup": false
  },
  {
    "Name": "LOD Info",
    "Description": "Provides Level of Detail (LOD) information for exported terrain, enabling optimized rendering and streaming in Unreal Engine.",
    "Type": "String",
    "IsGroup": false
  },
  {
    "Name": "Format",
    "Description": "Selects the file format for exported terrain data. Choose the format that best matches your Unreal Engine workflow.",
    "Type": "Enum",
    "IsGroup": false,
    "Flubs": [
      {
        "Name": "PNG",
        "Description": "Exports terrain data as PNG images, suitable for color maps and masks.",
        "Type": "EnumValue",
        "IsGroup": false
      },
      {
        "Name": "R16",
        "Description": "Exports terrain data as 16-bit RAW files, recommended for heightmaps to preserve elevation detail.",
        "Type": "EnumValue",
        "IsGroup": false
      },
      {
        "Name": "RAW",
        "Description": "Exports terrain data as RAW files, compatible with Unreal Engine for heightmaps and other data.",
        "Type": "EnumValue",
        "IsGroup": false
      }
    ]
  },
