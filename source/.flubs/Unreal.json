    "Type": "Boolean",
    "IsGroup": false
  },
  {
    "Name": "Target Size",
    "Description": "Specifies the desired export resolution for Unreal Engine heightmaps and textures. Choose from standard Unreal-compatible sizes for best results.",
    "Type": "Enum",
    "IsGroup": false,
    "Flubs": [
      {
        "Name": "x8129",
        "Description": "Exports at 8129 x 8129 pixels, suitable for very large landscapes in Unreal Engine.",
